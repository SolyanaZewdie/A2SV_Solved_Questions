class Solution(object):
    def findValidPair(self, s):
        """
        :type s: str
        :rtype: str
        """
        counts = {}
        
        for ch in s:
            if ch in counts:
                counts[ch] += 1
            else:
                counts[ch] = 1
        
        for i in range(len(s) - 1):
            first = s[i]
            second = s[i + 1]
            
            if first != second:
                if counts[first] == int(first) and counts[second] == int(second):
                    return first + second
        
        return ""
