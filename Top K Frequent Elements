class Solution(object):
    def topKFrequent(self, nums, k):
        unique = []
        for num in nums:
            if num not in unique:
                unique.append(num)
        freq = []
        for num in unique:
            count = 0
            for x in nums:
                if x == num:
                    count += 1
            freq.append([num, count])
        n = len(freq)
        for i in range(n):
            for j in range(i+1, n):
                if freq[j][1] > freq[i][1]:
                    freq[i], freq[j] = freq[j], freq[i]
        result = []
        for i in range(k):
            result.append(freq[i][0])
        return result
