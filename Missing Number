class Solution(object):
    def missingNumber(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = len(nums)
        # Create a set of all numbers in the array
        num_set = set(nums)
        
        # Check each number from 0 to n
        for i in range(n + 1):
            if i not in num_set:
                return i
