class Solution(object):
    def minimumIndex(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        candidate = None
        count = 0
        
        for num in nums:
            if count == 0:
                candidate = num
            if num == candidate:
                count += 1
            else:
                count -= 1
        
        total = 0
        for num in nums:
            if num == candidate:
                total += 1
        
        left_count = 0
        n = len(nums)
        
        for i in range(n - 1):
            if nums[i] == candidate:
                left_count += 1
            
            if left_count * 2 > (i + 1) and (total - left_count) * 2 > (n - i - 1):
                return i
        
        return -1
