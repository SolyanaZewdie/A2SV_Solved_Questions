class Solution(object):
    def longestConsecutive(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        nums_set = set(nums)
        longest = 0
        
        for num in nums_set:
            if num - 1 not in nums_set:
                current = num
                length = 1
                
                while current + 1 in nums_set:
                    current += 1
                    length += 1
                
                if length > longest:
                    longest = length
        
        return longest
