class Solution:
    def checkEqual(self, a, b) -> bool:
        if len(a) != len(b):
            return False
        
        freq = {}
        
        for x in a:
            freq[x] = freq.get(x, 0) + 1
        
        for x in b:
            if x not in freq:
                return False
            freq[x] -= 1
            if freq[x] < 0:
                return False
        
        return True
